// Cloudflare Workers Static Assets configuration
// Tells `npx wrangler deploy` where the static files live.
// The build output is produced by scripts/cf_build.sh.
{
  "name": "future-self",
  "compatibility_date": "2026-11-01",

  "assets": {
    // Flutter Web build output (relative to the repo root)
    "directory": "future_self_app/build/web",

    // go_router uses hash routing (/#/home), so SPA fallback is enough
    "not_found_handling": "single-page-application"
  }
}
